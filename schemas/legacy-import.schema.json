{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-planning-kit.local/schemas/legacy-import.schema.json",
  "title": "V3 immutable legacy import sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "entity_id",
    "kind",
    "slug",
    "title",
    "owner",
    "provenance",
    "source_path",
    "source_kind",
    "source_sha256",
    "imported_state",
    "confidence",
    "created_at",
    "source_analysis_ids",
    "write_scopes",
    "resource_claims"
  ],
  "properties": {
    "artifact_type": { "const": "legacy_import" },
    "schema_version": { "const": 3 },
    "entity_id": {
      "type": "string",
      "pattern": "^(ftr|ana|prj)_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": { "enum": ["feature", "analysis", "project"] },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provenance": { "const": "legacy_import" },
    "source_path": { "type": "string", "minLength": 1 },
    "source_kind": { "enum": ["file", "tree"] },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "imported_state": {
      "enum": [
        "PLANNED",
        "ACTIVE",
        "BLOCKED",
        "PARTIALLY_MERGED",
        "RECONCILIATION_PENDING",
        "COMPLETED",
        "CANCELLED",
        "SUPERSEDED",
        "UNKNOWN_LEGACY"
      ]
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source_analysis_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ana_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "write_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "kind", "path"],
        "properties": {
          "repository_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "enum": ["exact", "tree"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resource_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "mode", "isolation_key", "reason"],
        "properties": {
          "resource_id": { "type": "string", "minLength": 1, "maxLength": 300 },
          "mode": { "enum": ["read", "exclusive", "isolated", "unknown"] },
          "isolation_key": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
