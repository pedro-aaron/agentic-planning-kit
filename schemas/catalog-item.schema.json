{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-planning-kit.local/schemas/catalog-item.schema.json",
  "title": "V3 workspace catalog item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "item_id",
    "kind",
    "title",
    "summary",
    "status",
    "attributes",
    "relationships",
    "evidence"
  ],
  "properties": {
    "artifact_type": { "const": "catalog_item" },
    "schema_version": { "const": 3 },
    "item_id": {
      "type": "string",
      "pattern": "^cat_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "enum": [
        "repository",
        "subproject",
        "command",
        "resource",
        "gate",
        "contract",
        "store",
        "seam",
        "recipe",
        "convention",
        "practice",
        "policy",
        "unknown"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": {
      "enum": ["VERIFIED", "PLANNED", "UNKNOWN", "UNKNOWN_LEGACY", "DEPRECATED"]
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "value": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_item_id"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 100 },
          "target_item_id": {
            "type": "string",
            "pattern": "^cat_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "section"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "section": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    }
  }
}
