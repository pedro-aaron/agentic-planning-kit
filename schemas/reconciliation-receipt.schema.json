{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-planning-kit.local/schemas/reconciliation-receipt.schema.json",
  "title": "V3 immutable reconciliation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "receipt_id",
    "status",
    "started_at",
    "finished_at",
    "validated_against",
    "parent_receipt_id",
    "generator_version",
    "input_hashes",
    "output_hashes",
    "applied_delta_ids",
    "error_codes"
  ],
  "properties": {
    "artifact_type": { "const": "reconciliation_receipt" },
    "schema_version": { "const": 3 },
    "receipt_id": {
      "type": "string",
      "pattern": "^rec_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": { "enum": ["SUCCEEDED", "FAILED", "NOOP"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "validated_against": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "commit"],
        "properties": {
          "repository_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "parent_receipt_id": {
      "type": ["string", "null"],
      "pattern": "^rec_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generator_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "input_hashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathHash" }
    },
    "output_hashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathHash" }
    },
    "applied_delta_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^delta_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "error_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    }
  },
  "$defs": {
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
