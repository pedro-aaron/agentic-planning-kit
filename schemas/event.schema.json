{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-planning-kit.local/schemas/event.schema.json",
  "title": "V3 append-only entity state event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "event_id",
    "entity_id",
    "event_type",
    "state",
    "occurred_at",
    "actor",
    "parent_event_id",
    "expected_state",
    "revision_id",
    "run_id",
    "reconciliation_receipt_id",
    "reason"
  ],
  "properties": {
    "artifact_type": { "const": "event" },
    "schema_version": { "const": 3 },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^(ftr|ana|prj)_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "enum": ["CREATED", "TRANSITIONED", "IMPORTED", "RECONCILED"]
    },
    "state": {
      "enum": [
        "PLANNED",
        "ACTIVE",
        "BLOCKED",
        "PARTIALLY_MERGED",
        "RECONCILIATION_PENDING",
        "COMPLETED",
        "CANCELLED",
        "SUPERSEDED",
        "UNKNOWN_LEGACY"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1, "maxLength": 200 },
    "parent_event_id": {
      "type": ["string", "null"],
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_state": {
      "type": ["string", "null"],
      "enum": [
        null,
        "PLANNED",
        "ACTIVE",
        "BLOCKED",
        "PARTIALLY_MERGED",
        "RECONCILIATION_PENDING",
        "COMPLETED",
        "CANCELLED",
        "SUPERSEDED",
        "UNKNOWN_LEGACY"
      ]
    },
    "revision_id": {
      "type": ["string", "null"],
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": ["string", "null"],
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reconciliation_receipt_id": {
      "type": ["string", "null"],
      "pattern": "^rec_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason": { "type": ["string", "null"], "maxLength": 1000 }
  }
}
