{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-planning-kit.local/schemas/map-delta.schema.json",
  "title": "V3 semantic workspace map delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "delta_id",
    "entity_id",
    "item_id",
    "operation",
    "expected_item_hash",
    "candidate",
    "evidence",
    "evidence_commit"
  ],
  "properties": {
    "artifact_type": { "const": "map_delta" },
    "schema_version": { "const": 3 },
    "delta_id": {
      "type": "string",
      "pattern": "^delta_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^(ftr|ana|prj)_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^cat_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": { "enum": ["ADD", "REPLACE", "REMOVE"] },
    "expected_item_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "anyOf": [
        { "$ref": "catalog-item.schema.json" },
        { "type": "null" }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "evidence_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
